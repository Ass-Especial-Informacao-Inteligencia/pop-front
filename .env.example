# Exemplo de configuração do pop-front.
# Copie para .env e ajuste conforme o ambiente.
# O arquivo .env NÃO deve ser commitado (já está no .gitignore).

# Porta do servidor front (proxy Express)
PORT=3000

# Interface de bind (vazio = 0.0.0.0)
IP=

# URL base do backend (pop-back) usada pelo proxy
BACKEND_URL=http://127.0.0.1:3333
